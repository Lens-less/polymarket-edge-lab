[Unit]
Description=Read-only BTC edge-readiness capture health snapshot v0.8
After=polymm-btc-twap-edge-readiness-v08.service

[Service]
Type=oneshot
User=polybotv08
Group=polybotv08
WorkingDirectory=/opt/poly-mm-v08
ExecStart=/usr/local/bin/polymm-btc-twap-edge-readiness-v08-healthcheck
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ReadOnlyPaths=/opt/poly-mm-v08
ReadOnlyPaths=/var/lib/poly-mm-v08/data
ReadWritePaths=/var/lib/poly-mm-v08/monitor
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0027

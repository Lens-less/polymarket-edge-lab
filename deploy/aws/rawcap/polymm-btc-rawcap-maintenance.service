[Unit]
Description=Compress finalized BTC raw captures and enforce retention
After=polymm-btc-rawcap.service

[Service]
Type=oneshot
User=polybotraw
Group=polybotraw
WorkingDirectory=/opt/poly-mm-rawcap
ExecStart=/opt/poly-mm-rawcap/.venv/bin/python /opt/poly-mm-rawcap/scripts/maintain_btc_rawcap.py --data-root /var/lib/poly-mm-rawcap/data --compress-after-seconds 1800 --retention-days 30 --status-path /var/lib/poly-mm-rawcap/monitor/maintenance-latest.json
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ReadOnlyPaths=/opt/poly-mm-rawcap
ReadWritePaths=/var/lib/poly-mm-rawcap
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0027

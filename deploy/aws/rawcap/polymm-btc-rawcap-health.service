[Unit]
Description=BTC rawcap health snapshot

[Service]
Type=oneshot
User=polybotraw
Group=polybotraw
WorkingDirectory=/opt/poly-mm-rawcap
ExecStart=/usr/local/bin/polymm-btc-rawcap-healthcheck
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ReadOnlyPaths=/opt/poly-mm-rawcap
ReadWritePaths=/var/lib/poly-mm-rawcap
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0027

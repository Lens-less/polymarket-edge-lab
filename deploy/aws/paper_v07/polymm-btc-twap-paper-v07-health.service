[Unit]
Description=Read-only BTC 5m/15m paper v0.7 shadow health snapshot
After=polymm-btc-twap-paper-v07-performance.service

[Service]
Type=oneshot
User=polybotv07
Group=polybotv07
SupplementaryGroups=polybotv06
WorkingDirectory=/opt/poly-mm-v07
ExecStart=/usr/local/bin/polymm-btc-twap-paper-v07-healthcheck
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ReadOnlyPaths=/opt/poly-mm-v07
ReadOnlyPaths=/var/lib/poly-mm-v06
ReadWritePaths=/var/lib/poly-mm-v07
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0027

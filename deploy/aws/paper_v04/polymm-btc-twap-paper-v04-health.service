[Unit]
Description=Read-only BTC 5m/15m paper health snapshot v0.4
After=polymm-btc-twap-paper-v04.service

[Service]
Type=oneshot
User=polybot
Group=polybot
WorkingDirectory=/opt/poly-mm
ExecStart=/usr/local/bin/polymm-btc-twap-paper-v04-healthcheck
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/poly-mm
ReadWritePaths=/var/lib/poly-mm
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
SystemCallArchitectures=native

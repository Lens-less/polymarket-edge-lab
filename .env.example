# Optional legacy infrastructure configuration
#
# The public Edge Discovery Lab commands in README.md do not need this file.
# Copy it to .env only when developing the retained account/feed adapters.
# Never commit .env, wallet keys, API credentials, or authenticated proxy URLs.

# Keep simulation as the default. Setting this to false still cannot bypass the
# unconditional new-order block in src/edge_lab/compatibility.py.
DRY_RUN=true

# Leave credentials blank. They are not required for public-data research.
POLY_PRIVATE_KEY=
POLY_FUNDER=
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# Optional public endpoints. The checked-in defaults are repeated here only for
# local endpoint testing.
CHAIN_ID=137
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Risk enforcement remains mode-aware in src/config.py. Do not add an active
# RISK_ENFORCE=false line to a shared example configuration.

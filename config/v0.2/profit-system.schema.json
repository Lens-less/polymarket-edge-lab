{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profit System Configuration Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "strategies"
  ],
  "properties": {
    "schema_version": {
      "const": "profit-system.config.v0.2"
    },
    "generated_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/strategyConfig"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "decimalString": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "nonNegativeDecimalString": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "versionHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "riskLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_order_notional",
        "max_market_exposure",
        "max_event_exposure",
        "max_strategy_exposure",
        "max_total_exposure",
        "max_daily_loss",
        "max_drawdown",
        "max_open_orders",
        "max_unmatched_leg_seconds",
        "max_market_data_age_ms",
        "max_user_stream_gap_seconds",
        "max_order_rate"
      ],
      "properties": {
        "max_order_notional": {
          "$ref": "#/$defs/nonNegativeDecimalString"
        },
        "max_market_exposure": {
          "$ref": "#/$defs/nonNegativeDecimalString"
        },
        "max_event_exposure": {
          "$ref": "#/$defs/nonNegativeDecimalString"
        },
        "max_strategy_exposure": {
          "$ref": "#/$defs/nonNegativeDecimalString"
        },
        "max_total_exposure": {
          "$ref": "#/$defs/nonNegativeDecimalString"
        },
        "max_daily_loss": {
          "$ref": "#/$defs/nonNegativeDecimalString"
        },
        "max_drawdown": {
          "$ref": "#/$defs/nonNegativeDecimalString"
        },
        "max_open_orders": {
          "type": "integer",
          "minimum": 0
        },
        "max_unmatched_leg_seconds": {
          "$ref": "#/$defs/nonNegativeDecimalString"
        },
        "max_market_data_age_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_user_stream_gap_seconds": {
          "$ref": "#/$defs/nonNegativeDecimalString"
        },
        "max_order_rate": {
          "$ref": "#/$defs/nonNegativeDecimalString"
        }
      }
    },
    "strategyConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_id",
        "strategy_version",
        "hypothesis_summary",
        "operating_mode",
        "qualification",
        "allowed_modes",
        "min_net_edge",
        "min_trade_size",
        "max_candidate_ttl_seconds",
        "risk_limits",
        "code_version_hash"
      ],
      "properties": {
        "schema_version": {
          "const": "profit-system.strategy-config.v0.2"
        },
        "strategy_id": {
          "$ref": "#/$defs/identifier"
        },
        "strategy_version": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis_summary": {
          "type": "string",
          "minLength": 1
        },
        "operating_mode": {
          "type": "string",
          "enum": [
            "RESEARCH",
            "REPLAY",
            "PAPER",
            "SHADOW",
            "LIVE_CANARY",
            "LIVE_LIMITED",
            "KILLED"
          ]
        },
        "qualification": {
          "type": "string",
          "enum": [
            "RESEARCH_ONLY",
            "SHADOW_ONLY",
            "PROBE_ALLOWED",
            "LIVE_ALLOWED",
            "STOPPED"
          ]
        },
        "allowed_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "RESEARCH",
              "REPLAY",
              "PAPER",
              "SHADOW",
              "LIVE_CANARY",
              "LIVE_LIMITED",
              "KILLED"
            ]
          }
        },
        "min_net_edge": {
          "$ref": "#/$defs/decimalString"
        },
        "min_trade_size": {
          "$ref": "#/$defs/nonNegativeDecimalString"
        },
        "risk_penalty_multiplier": {
          "$ref": "#/$defs/nonNegativeDecimalString",
          "default": "1"
        },
        "max_candidate_ttl_seconds": {
          "$ref": "#/$defs/nonNegativeDecimalString"
        },
        "risk_limits": {
          "$ref": "#/$defs/riskLimits"
        },
        "market_whitelist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "effective_until": {
          "anyOf": [
            {
              "$ref": "#/$defs/utcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "code_version_hash": {
          "$ref": "#/$defs/versionHash"
        }
      }
    }
  }
}
